+TEST_F(UdfContinuationTest, NativeDeoptScopeRejectsCrossCodeRecovery) {
+  Ref<> region_code = Ref<>::steal(
+      Py_CompileString("value = 1", "<udf-region>", Py_file_input));
+  Ref<> source_code = Ref<>::steal(
+      Py_CompileString("value = 2", "<source-udf>", Py_file_input));
+  ASSERT_NE(region_code, nullptr);
+  ASSERT_NE(source_code, nullptr);
+
+  jit::DeoptMetadata metadata;
+  EXPECT_EQ(
+      jit::validateUdfContinuationDeoptScope(
+          metadata, reinterpret_cast<PyCodeObject*>(region_code.get())),
+      jit::UdfContinuationReject::kFrameMetadataMissing);
+
+  metadata.frame_meta.resize(1);
+  metadata.frame_meta[0].code =
+      reinterpret_cast<PyCodeObject*>(region_code.get());
+  EXPECT_EQ(
+      jit::validateUdfContinuationDeoptScope(
+          metadata, reinterpret_cast<PyCodeObject*>(region_code.get())),
+      jit::UdfContinuationReject::kNone);
+  EXPECT_EQ(
+      jit::validateUdfContinuationDeoptScope(
+          metadata, reinterpret_cast<PyCodeObject*>(source_code.get())),
+      jit::UdfContinuationReject::kCrossCodeDeopt);
+}
