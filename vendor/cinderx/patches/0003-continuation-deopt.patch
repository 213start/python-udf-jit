+PyObject* JITRT_UdfBuildContinuationPayload(PyObject*, PyObject* args) {
+  if (!PyTuple_CheckExact(args) || PyTuple_GET_SIZE(args) != 13) {
+    PyErr_SetString(
+        PyExc_TypeError,
+        "_udf_build_continuation_payload expects exactly 13 arguments");
+    return nullptr;
+  }
+  PyObject* abi_object = PyTuple_GET_ITEM(args, 0);
+  PyObject* reason_object = PyTuple_GET_ITEM(args, 1);
+  PyObject* resume_object = PyTuple_GET_ITEM(args, 2);
+  PyObject* namespace_object = PyTuple_GET_ITEM(args, 3);
+  PyObject* code_object = PyTuple_GET_ITEM(args, 4);
+  PyObject* first_line_object = PyTuple_GET_ITEM(args, 5);
+  PyObject* source_map = PyTuple_GET_ITEM(args, 6);
+  PyObject* values = PyTuple_GET_ITEM(args, 7);
+  PyObject* kinds = PyTuple_GET_ITEM(args, 8);
+  PyObject* nullable = PyTuple_GET_ITEM(args, 9);
+  PyObject* materialized = PyTuple_GET_ITEM(args, 10);
+  PyObject* active_exception = PyTuple_GET_ITEM(args, 11);
+  PyObject* committed_object = PyTuple_GET_ITEM(args, 12);
+
+  if (!PyLong_CheckExact(abi_object) || !PyUnicode_CheckExact(reason_object) ||
+      PyUnicode_GET_LENGTH(reason_object) == 0 ||
+      !PyUnicode_CheckExact(resume_object) ||
+      !PyUnicode_CheckExact(namespace_object) ||
+      !PyUnicode_CheckExact(code_object) ||
+      !PyLong_CheckExact(first_line_object) ||
+      !PyTuple_CheckExact(source_map) || !PyTuple_CheckExact(values) ||
+      !PyTuple_CheckExact(kinds) || !PyTuple_CheckExact(nullable) ||
+      !PyTuple_CheckExact(materialized) ||
+      !(active_exception == Py_None ||
+        PyExceptionInstance_Check(active_exception)) ||
+      !PyBool_Check(committed_object)) {
+    PyErr_SetString(PyExc_TypeError, "invalid UDF continuation payload shape");
+    return nullptr;
+  }
+
+  long abi_version = PyLong_AsLong(abi_object);
+  long first_line = PyLong_AsLong(first_line_object);
+  const char* resume_id = PyUnicode_AsUTF8(resume_object);
+  const char* namespace_sha256 = PyUnicode_AsUTF8(namespace_object);
+  const char* code_sha256 = PyUnicode_AsUTF8(code_object);
+  if (PyErr_Occurred()) {
+    return nullptr;
+  }
+  auto identity_reject = jit::validateUdfContinuationIdentity(
+      static_cast<int>(abi_version),
+      resume_id,
+      namespace_sha256,
+      code_sha256,
+      static_cast<int>(first_line),
+      committed_object == Py_True);
+  if (identity_reject != jit::UdfContinuationReject::kNone) {
+    PyErr_Format(
+        PyExc_ValueError,
+        "udf_continuation_%s",
+        jit::udfContinuationRejectName(identity_reject));
+    return nullptr;
+  }
+
+  if (PyTuple_GET_SIZE(source_map) != 6) {
+    PyErr_SetString(PyExc_ValueError, "udf_continuation_source_map_invalid");
+    return nullptr;
+  }
+  for (Py_ssize_t index = 0; index < 6; index++) {
+    PyObject* item = PyTuple_GET_ITEM(source_map, index);
+    if (item != Py_None && !PyLong_CheckExact(item)) {
+      PyErr_SetString(PyExc_ValueError, "udf_continuation_source_map_invalid");
+      return nullptr;
+    }
+  }
+
+  Py_ssize_t value_count = PyTuple_GET_SIZE(values);
+  if (PyTuple_GET_SIZE(kinds) != value_count ||
+      PyTuple_GET_SIZE(nullable) != value_count ||
+      PyTuple_GET_SIZE(materialized) != value_count) {
+    PyErr_SetString(
+        PyExc_ValueError, "udf_continuation_live_value_shape_mismatch");
+    return nullptr;
+  }
+
+  Ref<> live_payloads = Ref<>::steal(PyTuple_New(value_count));
+  if (live_payloads == nullptr) {
+    return nullptr;
+  }
+  for (Py_ssize_t index = 0; index < value_count; index++) {
+    PyObject* value = PyTuple_GET_ITEM(values, index);
+    PyObject* kind_object = PyTuple_GET_ITEM(kinds, index);
+    PyObject* nullable_object = PyTuple_GET_ITEM(nullable, index);
+    PyObject* materialized_object = PyTuple_GET_ITEM(materialized, index);
+    if (!PyUnicode_CheckExact(kind_object) || !PyBool_Check(nullable_object) ||
+        !PyBool_Check(materialized_object)) {
+      PyErr_SetString(
+          PyExc_TypeError, "invalid UDF continuation live value shape");
+      return nullptr;
+    }
+    const char* kind_name = PyUnicode_AsUTF8(kind_object);
+    jit::UdfContinuationValueKind kind;
+    if (kind_name == nullptr ||
+        !jit::parseUdfContinuationValueKind(kind_name, &kind)) {
+      PyErr_SetString(PyExc_ValueError, "udf_continuation_value_kind_mismatch");
+      return nullptr;
+    }
+    auto value_reject = jit::validateUdfContinuationValue(
+        kind,
+        nullable_object == Py_True,
+        materialized_object == Py_True,
+        value);
+    if (value_reject != jit::UdfContinuationReject::kNone) {
+      PyErr_Format(
+          PyExc_ValueError,
+          "udf_continuation_%s:%zd",
+          jit::udfContinuationRejectName(value_reject),
+          index);
+      return nullptr;
+    }
+    PyObject* entry = PyTuple_Pack(
+        4, kind_object, nullable_object, materialized_object, value);
+    if (entry == nullptr) {
+      return nullptr;
+    }
+    PyTuple_SET_ITEM(live_payloads, index, entry);
+  }
+
+  return PyTuple_Pack(
+      10,
+      abi_object,
+      reason_object,
+      resume_object,
+      namespace_object,
+      code_object,
+      first_line_object,
+      source_map,
+      live_payloads.get(),
+      active_exception,
+      committed_object);
+}
