+const char* udfContinuationRejectName(UdfContinuationReject reason) {
+  switch (reason) {
+    case UdfContinuationReject::kNone:
+      return "none";
+    case UdfContinuationReject::kAbiMismatch:
+      return "abi_mismatch";
+    case UdfContinuationReject::kResumeIdInvalid:
+      return "resume_id_invalid";
+    case UdfContinuationReject::kSourceIdentityInvalid:
+      return "source_identity_invalid";
+    case UdfContinuationReject::kCommitRequired:
+      return "commit_required";
+    case UdfContinuationReject::kMaterializationFailed:
+      return "materialization_failed";
+    case UdfContinuationReject::kValueKindMismatch:
+      return "value_kind_mismatch";
+    case UdfContinuationReject::kValueTypeMismatch:
+      return "value_type_mismatch";
+    case UdfContinuationReject::kFrameMetadataMissing:
+      return "frame_metadata_missing";
+    case UdfContinuationReject::kCrossCodeDeopt:
+      return "cross_code_deopt";
+  }
+  JIT_ABORT("Invalid UdfContinuationReject {}", static_cast<int>(reason));
+}
+
+bool parseUdfContinuationValueKind(
+    std::string_view name,
+    UdfContinuationValueKind* result) {
+  if (result == nullptr) {
+    return false;
+  }
+  if (name == "python_object") {
+    *result = UdfContinuationValueKind::kPythonObject;
+  } else if (name == "bool") {
+    *result = UdfContinuationValueKind::kBool;
+  } else if (name == "int32") {
+    *result = UdfContinuationValueKind::kInt32;
+  } else if (name == "int64") {
+    *result = UdfContinuationValueKind::kInt64;
+  } else if (name == "float32") {
+    *result = UdfContinuationValueKind::kFloat32;
+  } else if (name == "float64") {
+    *result = UdfContinuationValueKind::kFloat64;
+  } else {
+    return false;
+  }
+  return true;
+}
+
+namespace {
+
+bool isLowerHexDigest(std::string_view value) {
+  if (value.size() != 64) {
+    return false;
+  }
+  for (char character : value) {
+    if (!((character >= '0' && character <= '9') ||
+          (character >= 'a' && character <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+} // namespace
+
+UdfContinuationReject validateUdfContinuationIdentity(
+    int abi_version,
+    std::string_view resume_id,
+    std::string_view namespace_sha256,
+    std::string_view code_sha256,
+    int first_line,
+    bool committed) {
+  if (abi_version != kUdfContinuationAbiVersion) {
+    return UdfContinuationReject::kAbiMismatch;
+  }
+  if (resume_id.size() != 67 || resume_id.substr(0, 3) != "v1:" ||
+      !isLowerHexDigest(resume_id.substr(3))) {
+    return UdfContinuationReject::kResumeIdInvalid;
+  }
+  if (!isLowerHexDigest(namespace_sha256) || !isLowerHexDigest(code_sha256) ||
+      first_line <= 0) {
+    return UdfContinuationReject::kSourceIdentityInvalid;
+  }
+  if (!committed) {
+    return UdfContinuationReject::kCommitRequired;
+  }
+  return UdfContinuationReject::kNone;
+}
+
+UdfContinuationReject validateUdfContinuationValue(
+    UdfContinuationValueKind kind,
+    bool nullable,
+    bool materialized,
+    PyObject* value) {
+  if (!materialized) {
+    return UdfContinuationReject::kMaterializationFailed;
+  }
+  if (value == Py_None) {
+    return nullable ? UdfContinuationReject::kNone
+                    : UdfContinuationReject::kValueTypeMismatch;
+  }
+  switch (kind) {
+    case UdfContinuationValueKind::kPythonObject:
+      return UdfContinuationReject::kNone;
+    case UdfContinuationValueKind::kBool:
+      return PyBool_Check(value) ? UdfContinuationReject::kNone
+                                 : UdfContinuationReject::kValueTypeMismatch;
+    case UdfContinuationValueKind::kInt32:
+    case UdfContinuationValueKind::kInt64: {
+      if (!PyLong_CheckExact(value)) {
+        return UdfContinuationReject::kValueTypeMismatch;
+      }
+      int overflow = 0;
+      long long converted = PyLong_AsLongLongAndOverflow(value, &overflow);
+      if (overflow != 0 || PyErr_Occurred()) {
+        PyErr_Clear();
+        return UdfContinuationReject::kValueTypeMismatch;
+      }
+      if (kind == UdfContinuationValueKind::kInt32 &&
+          (converted < std::numeric_limits<int32_t>::min() ||
+           converted > std::numeric_limits<int32_t>::max())) {
+        return UdfContinuationReject::kValueTypeMismatch;
+      }
+      return UdfContinuationReject::kNone;
+    }
+    case UdfContinuationValueKind::kFloat32:
+    case UdfContinuationValueKind::kFloat64: {
+      if (!PyFloat_CheckExact(value)) {
+        return UdfContinuationReject::kValueTypeMismatch;
+      }
+      double converted = PyFloat_AS_DOUBLE(value);
+      if (kind == UdfContinuationValueKind::kFloat32 &&
+          std::isfinite(converted) &&
+          static_cast<double>(static_cast<float>(converted)) != converted) {
+        return UdfContinuationReject::kValueTypeMismatch;
+      }
+      return UdfContinuationReject::kNone;
+    }
+  }
+  return UdfContinuationReject::kValueKindMismatch;
+}
+
+UdfContinuationReject validateUdfContinuationDeoptScope(
+    const DeoptMetadata& metadata,
+    PyCodeObject* expected_region_code) {
+  if (expected_region_code == nullptr || metadata.frame_meta.size() != 1 ||
+      metadata.innermostFrame().code == nullptr) {
+    return UdfContinuationReject::kFrameMetadataMissing;
+  }
+  if (metadata.innermostFrame().code != expected_region_code) {
+    return UdfContinuationReject::kCrossCodeDeopt;
+  }
+  return UdfContinuationReject::kNone;
+}
