+TEST_F(UdfContinuationTest, RuntimePayloadPreservesTypedValuesAndAliases) {
+  runStockCode(R"(
+import struct
+
+import cinderx.jit
+from cinderjit import _udf_build_continuation_payload
+
+digest = "a" * 64
+resume_id = "v1:" + "b" * 64
+source_map = (1, 18, 40, 4, 40, 18)
+marker = []
+active = LookupError("active")
+f32 = struct.unpack("f", struct.pack("f", 1.1))[0]
+values = (marker, marker, True, 7, 2**40, f32, -3.5, None)
+kinds = (
+    "python_object",
+    "python_object",
+    "bool",
+    "int32",
+    "int64",
+    "float32",
+    "float64",
+    "python_object",
+)
+nullable = (False, False, False, False, False, False, False, True)
+materialized = (True,) * len(values)
+
+def build():
+    return _udf_build_continuation_payload(
+        1,
+        "cinderx_deopt",
+        resume_id,
+        digest,
+        digest,
+        12,
+        source_map,
+        values,
+        kinds,
+        nullable,
+        materialized,
+        active,
+        True,
+    )
+
+assert cinderx.jit.force_compile(build)
+assert cinderx.jit.is_jit_compiled(build)
+payload = build()
+assert type(payload) is tuple and len(payload) == 10
+assert payload[:7] == (
+    1,
+    "cinderx_deopt",
+    resume_id,
+    digest,
+    digest,
+    12,
+    source_map,
+)
+live = payload[7]
+assert all(entry[2] is True for entry in live)
+assert live[0][3] is marker
+assert live[1][3] is marker
+assert live[0][3] is live[1][3]
+assert tuple(entry[3] for entry in live) == values
+assert payload[8] is active
+assert payload[9] is True
+)");
+}
