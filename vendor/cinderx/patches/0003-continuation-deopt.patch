+TEST_F(UdfContinuationTest, RuntimePayloadRejectsUnsafeResumeMatrix) {
+  runStockCode(R"(
+import struct
+
+from cinderjit import _udf_build_continuation_payload
+
+digest = "a" * 64
+resume_id = "v1:" + "b" * 64
+source_map = (1, 18, 40, 4, 40, 18)
+valid = [
+    1,
+    "cinderx_deopt",
+    resume_id,
+    digest,
+    digest,
+    12,
+    source_map,
+    (7,),
+    ("int32",),
+    (False,),
+    (True,),
+    None,
+    True,
+]
+
+cases = (
+    (0, 2, "abi_mismatch"),
+    (2, "v2:" + "b" * 64, "resume_id_invalid"),
+    (3, "A" * 64, "source_identity_invalid"),
+    (12, False, "commit_required"),
+    (7, (), "live_value_shape_mismatch"),
+    (10, (False,), "materialization_failed"),
+    (7, (2**31,), "value_type_mismatch"),
+    (7, (1.1,), "value_type_mismatch"),
+)
+for index, replacement, reason in cases:
+    arguments = valid.copy()
+    arguments[index] = replacement
+    if index == 7 and isinstance(replacement, tuple) and replacement == (1.1,):
+        arguments[8] = ("float32",)
+    try:
+        _udf_build_continuation_payload(*arguments)
+    except (TypeError, ValueError) as error:
+        assert reason in str(error), (reason, error)
+    else:
+        raise AssertionError(f"unsafe continuation accepted: {reason}")
+)");
+}
