+#include <string>
+
+using UdfTypedLoopIntrinsicTest = RuntimeTest;
+
+namespace {
+
+std::unique_ptr<jit::hir::Function> parseUnicodeCountFunction() {
+  return jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = RefineType<UnicodeExact> v0
+    v2 = LoadConst<CInt64[0]>
+    v3 = UnicodeCountProperty v1 v2
+    v4 = PrimitiveBox<CInt64> v3 {
+      FrameState {
+        CurInstrOffset 0
+      }
+    }
+    Return v4
+  }
+}
+)");
+}
+
+} // namespace
+
+TEST_F(UdfTypedLoopIntrinsicTest, HIRMetadataIsTypedPureAndReplayable) {
+  auto function = parseUnicodeCountFunction();
+  ASSERT_NE(function, nullptr);
+
+  const jit::hir::Instr* count = nullptr;
+  for (const auto& block : function->cfg.blocks) {
+    for (const auto& instr : block) {
+      if (instr.IsUnicodeCountProperty()) {
+        count = &instr;
+      }
+    }
+  }
+
+  ASSERT_NE(count, nullptr);
+  EXPECT_EQ(jit::hir::outputType(*count), jit::hir::TCInt64);
+  EXPECT_TRUE(count->isReplayable());
+  EXPECT_FALSE(jit::hir::isPassthrough(*count));
+  EXPECT_FALSE(jit::hir::hasArbitraryExecution(*count));
+  EXPECT_EQ(jit::hir::memoryEffects(*count).may_store, jit::hir::AEmpty);
+}
+
+TEST_F(UdfTypedLoopIntrinsicTest, LIRCallsUnicodeCountRuntimeHelper) {
+  auto function = parseUnicodeCountFunction();
+  ASSERT_NE(function, nullptr);
+
+  jit::Compiler::runPasses(
+      *function,
+      static_cast<jit::PassConfig>(
+          jit::PassConfig::kAllExceptInliner &
+          ~jit::PassConfig::kInsertUpdatePrevInstr));
+
+  jit::codegen::Environ env;
+  env.ctx = jit::getContext();
+  jit::CodeRuntime code_runtime{
+      function->code, function->builtins, function->globals};
+  env.code_rt = &code_runtime;
+
+  jit::lir::LIRGenerator generator{function.get(), &env};
+  auto lir = generator.TranslateFunction();
+  lir->sortBasicBlocks();
+  std::stringstream stream;
+  stream << *lir;
+  const std::string text = stream.str();
+
+  EXPECT_NE(
+      text.find(fmt::format(
+          "{}", reinterpret_cast<uint64_t>(JITRT_UnicodeCountProperty))),
+      std::string::npos)
+      << text;
+}
