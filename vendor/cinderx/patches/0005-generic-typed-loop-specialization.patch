+namespace {
+
+template <typename Predicate>
+int64_t countUnicodeProperty(PyObject* text, Predicate predicate) {
+  const Py_ssize_t length = PyUnicode_GET_LENGTH(text);
+  const int kind = PyUnicode_KIND(text);
+  const void* data = PyUnicode_DATA(text);
+  int64_t count = 0;
+  for (Py_ssize_t index = 0; index < length; index++) {
+    count += predicate(PyUnicode_READ(kind, data, index)) ? 1 : 0;
+  }
+  return count;
+}
+
+bool isValidUnicodeProperty(int64_t property) {
+  return property >= kUdfUnicodePropertyMin &&
+      property <= kUdfUnicodePropertyMax;
+}
+
+} // namespace
+
+int64_t JITRT_UnicodeCountProperty(PyObject* text, int64_t property) {
+  JIT_DCHECK(
+      PyUnicode_CheckExact(text), "UnicodeCountProperty requires an exact str");
+  JIT_DCHECK(
+      isValidUnicodeProperty(property),
+      "UnicodeCountProperty received an invalid property id");
+  switch (static_cast<UdfUnicodeProperty>(property)) {
+    case UdfUnicodeProperty::kAlnum:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISALNUM(ch); });
+    case UdfUnicodeProperty::kAlpha:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISALPHA(ch); });
+    case UdfUnicodeProperty::kDecimal:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISDECIMAL(ch); });
+    case UdfUnicodeProperty::kDigit:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISDIGIT(ch); });
+    case UdfUnicodeProperty::kNumeric:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISNUMERIC(ch); });
+    case UdfUnicodeProperty::kSpace:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISSPACE(ch); });
+  }
+  JIT_ABORT("unreachable Unicode property id {}", property);
+}
+
+PyObject* JITRT_UdfUnicodeCountProperty(PyObject*, PyObject* args) {
+  PyObject* text;
+  PyObject* property_obj;
+  if (!PyArg_ParseTuple(args, "OO", &text, &property_obj)) {
+    return nullptr;
+  }
+  if (!PyUnicode_CheckExact(text)) {
+    PyErr_SetString(
+        PyExc_TypeError, "Unicode property count expects an exact str");
+    return nullptr;
+  }
+  if (!PyLong_CheckExact(property_obj)) {
+    PyErr_SetString(
+        PyExc_TypeError, "Unicode property id expects an exact int");
+    return nullptr;
+  }
+  int overflow = 0;
+  const long property = PyLong_AsLongAndOverflow(property_obj, &overflow);
+  if (overflow != 0 || !isValidUnicodeProperty(property)) {
+    PyErr_SetString(PyExc_ValueError, "unsupported Unicode property id");
+    return nullptr;
+  }
+  return PyLong_FromLongLong(JITRT_UnicodeCountProperty(text, property));
+}
