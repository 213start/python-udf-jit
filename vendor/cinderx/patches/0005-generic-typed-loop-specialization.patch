@@ -0,0 +1,131 @@
+"""Tests for generic typed-loop Unicode property specialization."""
+
+import unittest
+
+import cinderx.jit
+
+try:
+    from cinderjit import _udf_unicode_count_property
+except ImportError:
+    _udf_unicode_count_property = None
+
+
+PROPERTY_METHODS = (
+    "isalnum",
+    "isalpha",
+    "isdecimal",
+    "isdigit",
+    "isnumeric",
+    "isspace",
+)
+
+
+def count_alnum(text):
+    return _udf_unicode_count_property(text, 0)
+
+
+def count_alpha(text):
+    return _udf_unicode_count_property(text, 1)
+
+
+def count_decimal(text):
+    return _udf_unicode_count_property(text, 2)
+
+
+def count_digit(text):
+    return _udf_unicode_count_property(text, 3)
+
+
+def count_numeric(text):
+    return _udf_unicode_count_property(text, 4)
+
+
+def count_space(text):
+    return _udf_unicode_count_property(text, 5)
+
+
+SPECIALIZED_FUNCTIONS = (
+    count_alnum,
+    count_alpha,
+    count_decimal,
+    count_digit,
+    count_numeric,
+    count_space,
+)
+
+
+@unittest.skipUnless(
+    cinderx.jit.is_enabled() and _udf_unicode_count_property is not None,
+    "requires CinderX JIT typed-loop helper",
+)
+class UdfTypedLoopIntrinsicTests(unittest.TestCase):
+    def test_public_helper_matches_python_unicode_semantics(self):
+        samples = (
+            "",
+            "ASCII 123\t\n",
+            "A²⅕٣ 中\u2003",
+            "e\u0301 café Ελληνικά",
+            "𝟡１２３",
+        )
+        for text in samples:
+            for property_id, method in enumerate(PROPERTY_METHODS):
+                with self.subTest(text=text, property=method):
+                    expected = sum(getattr(char, method)() for char in text)
+                    self.assertEqual(
+                        _udf_unicode_count_property(text, property_id),
+                        expected,
+                    )
+
+    def test_public_helper_requires_exact_types_and_known_property(self):
+        class TextSubclass(str):
+            pass
+
+        class IntSubclass(int):
+            pass
+
+        for text in (TextSubclass("abc"), b"abc", None):
+            with self.subTest(text=text):
+                with self.assertRaises(TypeError):
+                    _udf_unicode_count_property(text, 0)
+        for property_id in (IntSubclass(0), True, 0.0):
+            with self.subTest(property_id=property_id):
+                with self.assertRaises(TypeError):
+                    _udf_unicode_count_property("abc", property_id)
+        for property_id in (-1, len(PROPERTY_METHODS), 2**100):
+            with self.subTest(property_id=property_id):
+                with self.assertRaises(ValueError):
+                    _udf_unicode_count_property("abc", property_id)
+
+    def test_each_generic_property_lowers_to_one_typed_hir_operation(self):
+        text = "A²⅕٣ 中\u2003"
+        for property_id, (function, method) in enumerate(
+            zip(SPECIALIZED_FUNCTIONS, PROPERTY_METHODS)
+        ):
+            with self.subTest(property=method):
+                self.assertTrue(cinderx.jit.force_compile(function))
+                counts = cinderx.jit.get_function_hir_opcode_counts(function)
+                self.assertEqual(counts.get("UnicodeCountProperty", 0), 1, counts)
+                expected = sum(getattr(char, method)() for char in text)
+                self.assertEqual(function(text), expected)
+
+        class TextSubclass(str):
+            pass
+
+        with self.assertRaises(TypeError):
+            count_alnum(TextSubclass("abc"))
+
+    def test_unrelated_python_function_is_not_specialized(self):
+        def fake_count(text, property_id):
+            return sum(char.isalnum() for char in text) + property_id
+
+        def wrapper(text):
+            return fake_count(text, 0)
+
+        self.assertTrue(cinderx.jit.force_compile(wrapper))
+        counts = cinderx.jit.get_function_hir_opcode_counts(wrapper)
+        self.assertEqual(counts.get("UnicodeCountProperty", 0), 0, counts)
+        self.assertEqual(wrapper("a!"), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
