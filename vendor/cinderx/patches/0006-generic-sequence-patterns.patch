+PyObject* JITRT_UnicodeMapSequence(
+    PyObject* text,
+    PyObject* keys,
+    PyObject* values) {
+  JIT_DCHECK(
+      PyUnicode_CheckExact(text), "UnicodeMapSequence requires an exact str");
+  JIT_DCHECK(
+      isValidUnicodeMapDescriptor(keys, values),
+      "UnicodeMapSequence received an invalid descriptor");
+  const Py_ssize_t length = PyUnicode_GET_LENGTH(text);
+  PyUnicodeWriter* writer = PyUnicodeWriter_Create(length);
+  if (writer == nullptr) {
+    return nullptr;
+  }
+  for (Py_ssize_t index = 0; index < length; index++) {
+    if (PyUnicodeWriter_WriteChar(
+            writer,
+            mapUnicodeScalar(unicodeAt(text, index), keys, values)) < 0) {
+      PyUnicodeWriter_Discard(writer);
+      return nullptr;
+    }
+  }
+  return PyUnicodeWriter_Finish(writer);
+}
+
+PyObject* JITRT_UnicodeFsmSequence(
+    PyObject* text,
+    int64_t property,
+    int64_t initial_state,
+    PyObject* descriptor) {
+  JIT_DCHECK(
+      PyUnicode_CheckExact(text), "UnicodeFsmSequence requires an exact str");
+  JIT_DCHECK(
+      isValidUnicodeFsmDescriptor(
+          property,
+          initial_state,
+          descriptor),
+      "UnicodeFsmSequence received an invalid descriptor");
+  const Py_ssize_t input_length = PyUnicode_GET_LENGTH(text);
+  const Py_ssize_t table_length = PyUnicode_GET_LENGTH(descriptor) / 3;
+  PyUnicodeWriter* writer = PyUnicodeWriter_Create(input_length);
+  if (writer == nullptr) {
+    return nullptr;
+  }
+  int64_t state = initial_state;
+  for (Py_ssize_t index = 0; index < input_length; index++) {
+    const Py_UCS4 ch = unicodeAt(text, index);
+    const Py_ssize_t table_index =
+        state * 2 + unicodePropertyMatches(ch, property);
+    const Py_UCS4 action =
+        unicodeAt(descriptor, table_length + table_index);
+    const Py_UCS4 emission =
+        unicodeAt(descriptor, 2 * table_length + table_index);
+    if (((action == 2 || action == 3) &&
+         PyUnicodeWriter_WriteChar(writer, emission) < 0) ||
+        ((action == 1 || action == 3 || action == 4) &&
+         PyUnicodeWriter_WriteChar(writer, ch) < 0) ||
+        (action == 4 &&
+         PyUnicodeWriter_WriteChar(writer, emission) < 0)) {
+      PyUnicodeWriter_Discard(writer);
+      return nullptr;
+    }
+    state = unicodeAt(descriptor, table_index);
+  }
+  return PyUnicodeWriter_Finish(writer);
+}
