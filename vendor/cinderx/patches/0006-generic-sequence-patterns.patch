+PyObject* JITRT_UdfUnicodeMapSequence(PyObject*, PyObject* args) {
+  PyObject* text;
+  PyObject* keys;
+  PyObject* values;
+  if (!PyArg_ParseTuple(args, "OOO", &text, &keys, &values)) {
+    return nullptr;
+  }
+  if (!PyUnicode_CheckExact(text) || !PyUnicode_CheckExact(keys) ||
+      !PyUnicode_CheckExact(values)) {
+    PyErr_SetString(
+        PyExc_TypeError, "Unicode map helper expects exact str arguments");
+    return nullptr;
+  }
+  if (!isValidUnicodeMapDescriptor(keys, values)) {
+    PyErr_SetString(PyExc_ValueError, "invalid Unicode map descriptor");
+    return nullptr;
+  }
+  return JITRT_UnicodeMapSequence(text, keys, values);
+}
+
+PyObject* JITRT_UdfUnicodeFsmSequence(PyObject*, PyObject* args) {
+  PyObject* text;
+  PyObject* property_obj;
+  PyObject* initial_state_obj;
+  PyObject* descriptor;
+  if (!PyArg_ParseTuple(
+          args,
+          "OOOO",
+          &text,
+          &property_obj,
+          &initial_state_obj,
+          &descriptor)) {
+    return nullptr;
+  }
+  if (!PyUnicode_CheckExact(text) || !PyLong_CheckExact(property_obj) ||
+      !PyLong_CheckExact(initial_state_obj) ||
+      !PyUnicode_CheckExact(descriptor)) {
+    PyErr_SetString(
+        PyExc_TypeError,
+        "Unicode FSM helper expects exact str and int arguments");
+    return nullptr;
+  }
+  int property_overflow = 0;
+  int state_overflow = 0;
+  const long property =
+      PyLong_AsLongAndOverflow(property_obj, &property_overflow);
+  const long initial_state =
+      PyLong_AsLongAndOverflow(initial_state_obj, &state_overflow);
+  if (property_overflow != 0 || state_overflow != 0 ||
+      !isValidUnicodeFsmDescriptor(
+          property,
+          initial_state,
+          descriptor)) {
+    PyErr_SetString(PyExc_ValueError, "invalid Unicode FSM descriptor");
+    return nullptr;
+  }
+  return JITRT_UnicodeFsmSequence(
+      text,
+      property,
+      initial_state,
+      descriptor);
+}
