+bool unicodePropertyMatches(Py_UCS4 ch, int64_t property) {
+  switch (static_cast<UdfUnicodeProperty>(property)) {
+    case UdfUnicodeProperty::kAlnum:
+      return Py_UNICODE_ISALNUM(ch);
+    case UdfUnicodeProperty::kAlpha:
+      return Py_UNICODE_ISALPHA(ch);
+    case UdfUnicodeProperty::kDecimal:
+      return Py_UNICODE_ISDECIMAL(ch);
+    case UdfUnicodeProperty::kDigit:
+      return Py_UNICODE_ISDIGIT(ch);
+    case UdfUnicodeProperty::kNumeric:
+      return Py_UNICODE_ISNUMERIC(ch);
+    case UdfUnicodeProperty::kSpace:
+      return Py_UNICODE_ISSPACE(ch);
+  }
+  JIT_ABORT("unreachable Unicode property id {}", property);
+}
+
+Py_UCS4 unicodeAt(PyObject* value, Py_ssize_t index) {
+  return PyUnicode_READ(
+      PyUnicode_KIND(value), PyUnicode_DATA(value), index);
+}
+
+bool isValidUnicodeMapDescriptor(PyObject* keys, PyObject* values) {
+  if (!PyUnicode_CheckExact(keys) || !PyUnicode_CheckExact(values)) {
+    return false;
+  }
+  const Py_ssize_t length = PyUnicode_GET_LENGTH(keys);
+  if (length != PyUnicode_GET_LENGTH(values) || length > 256) {
+    return false;
+  }
+  for (Py_ssize_t index = 1; index < length; index++) {
+    if (unicodeAt(keys, index - 1) >= unicodeAt(keys, index)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool isValidUnicodeFsmDescriptor(
+    int64_t property,
+    int64_t initial_state,
+    PyObject* descriptor) {
+  if (!isValidUnicodeProperty(property) ||
+      !PyUnicode_CheckExact(descriptor)) {
+    return false;
+  }
+  const Py_ssize_t descriptor_length = PyUnicode_GET_LENGTH(descriptor);
+  if (descriptor_length == 0 || descriptor_length % 3 != 0) {
+    return false;
+  }
+  const Py_ssize_t table_length = descriptor_length / 3;
+  if (table_length > 128 || table_length % 2 != 0) {
+    return false;
+  }
+  const Py_ssize_t state_count = table_length / 2;
+  if (state_count > 64 || initial_state < 0 || initial_state >= state_count) {
+    return false;
+  }
+  for (Py_ssize_t index = 0; index < table_length; index++) {
+    if (unicodeAt(descriptor, index) >= state_count ||
+        unicodeAt(descriptor, table_length + index) > 4) {
+      return false;
+    }
+  }
+  return true;
+}
+
+Py_UCS4 mapUnicodeScalar(Py_UCS4 ch, PyObject* keys, PyObject* values) {
+  const Py_ssize_t table_length = PyUnicode_GET_LENGTH(keys);
+  if (table_length == 0 || ch < unicodeAt(keys, 0) ||
+      ch > unicodeAt(keys, table_length - 1)) {
+    return ch;
+  }
+  Py_ssize_t left = 0;
+  Py_ssize_t right = table_length;
+  while (left < right) {
+    const Py_ssize_t middle = left + (right - left) / 2;
+    const Py_UCS4 key = unicodeAt(keys, middle);
+    if (key < ch) {
+      left = middle + 1;
+    } else {
+      right = middle;
+    }
+  }
+  if (left < table_length && unicodeAt(keys, left) == ch) {
+    return unicodeAt(values, left);
+  }
+  return ch;
+}
