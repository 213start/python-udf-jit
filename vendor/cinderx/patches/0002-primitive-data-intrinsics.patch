+// Copyright (c) Meta Platforms, Inc. and affiliates.
+
+#include "cinderx/RuntimeTests/fixtures.h"
+
+using UdfDescriptorFuzzTest = RuntimeTest;
+
+TEST_F(UdfDescriptorFuzzTest, DeterministicLifecycleAndTypeMatrix) {
+  runStockCode(R"(
+import random
+
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_data_is_null,
+    _udf_data_load_bool,
+    _udf_data_load_f32,
+    _udf_data_load_f64,
+    _udf_data_load_i32,
+    _udf_data_load_i64,
+    _udf_data_store_bool,
+    _udf_data_store_f32,
+    _udf_data_store_f64,
+    _udf_data_store_i32,
+    _udf_data_store_i64,
+    _udf_data_store_null,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+    _udf_set_scalar_slot,
+)
+
+rng = random.Random(0x554446)
+types = ("bool", "int32", "int64", "float32", "float64")
+loads = {
+    "bool": _udf_data_load_bool,
+    "int32": _udf_data_load_i32,
+    "int64": _udf_data_load_i64,
+    "float32": _udf_data_load_f32,
+    "float64": _udf_data_load_f64,
+}
+stores = {
+    "bool": _udf_data_store_bool,
+    "int32": _udf_data_store_i32,
+    "int64": _udf_data_store_i64,
+    "float32": _udf_data_store_f32,
+    "float64": _udf_data_store_f64,
+}
+values = {
+    "bool": (False, True),
+    "int32": (-(2**31), -1, 0, 1, 2**31 - 1),
+    "int64": (-(2**63), -(2**40), 0, 2**40, 2**63 - 1),
+    "float32": (-3.25, -0.0, 0.0, 1.5, float("inf"), float("-inf")),
+    "float64": (-3.25, -0.0, 0.0, 1.5, float("inf"), float("-inf")),
+}
+
+for iteration in range(500):
+    scalar_type = rng.choice(types)
+    nullable = bool(rng.getrandbits(1))
+    slot = _udf_create_scalar_slot(scalar_type, nullable)
+    _udf_begin_scalar_slot_borrow(slot)
+    guarded = _udf_guard_data_handle(slot)
+
+    if nullable and rng.randrange(4) == 0:
+        if rng.getrandbits(1):
+            _udf_set_scalar_slot(slot, None)
+        else:
+            _udf_data_store_null(guarded)
+        assert _udf_data_is_null(_udf_guard_data_handle(slot))
+        try:
+            loads[scalar_type](_udf_guard_data_handle(slot))
+        except TypeError:
+            pass
+        else:
+            raise AssertionError("null value escaped through a typed load")
+    else:
+        value = rng.choice(values[scalar_type])
+        if rng.getrandbits(1):
+            _udf_set_scalar_slot(slot, value)
+        else:
+            assert stores[scalar_type](guarded, value) == value
+        assert not _udf_data_is_null(_udf_guard_data_handle(slot))
+        loads[scalar_type](_udf_guard_data_handle(slot))
+
+    wrong_type = rng.choice(tuple(item for item in types if item != scalar_type))
+    try:
+        loads[wrong_type](_udf_guard_data_handle(slot))
+    except TypeError:
+        pass
+    else:
+        raise AssertionError("a mismatched typed load unexpectedly succeeded")
+
+    _udf_end_scalar_slot_borrow(slot)
+    for invalid_operation in (
+        lambda: _udf_guard_data_handle(slot),
+        lambda: loads[scalar_type](slot),
+    ):
+        try:
+            invalid_operation()
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("ended borrow unexpectedly remained usable")
+    _udf_release_scalar_slot(slot)
+    _udf_release_scalar_slot(slot)
+
+for forged in (object(), None, 1, 1.0, "slot"):
+    try:
+        _udf_guard_data_handle(forged)
+    except TypeError:
+        pass
+    else:
+        raise AssertionError("forged descriptor unexpectedly passed its guard")
+)");
+}
