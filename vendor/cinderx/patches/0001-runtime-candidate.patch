+bool isExactUdfScalarHelper(Register* callable, PyCFunction expected) {
+  Type callable_type = callable->type();
+  if (!callable_type.hasObjectSpec()) {
+    return false;
+  }
+  PyObject* callable_obj = callable_type.objectSpec();
+  if (Py_TYPE(callable_obj) != &PyCFunction_Type) {
+    return false;
+  }
+  auto* function = reinterpret_cast<PyCFunctionObject*>(callable_obj);
+  return function->m_ml->ml_meth == expected;
+}
+
+const VectorCall* guardedUdfScalarProducer(Register* value) {
+  while (value->instr()->IsAssign() || value->instr()->IsCheckExc()) {
+    value = value->instr()->GetOperand(0);
+  }
+  if (!value->instr()->IsVectorCall()) {
+    return nullptr;
+  }
+  return static_cast<const VectorCall*>(value->instr());
+}
+
+bool isAdjacentUdfGuardChain(const VectorCall* guard, const VectorCall* load) {
+  if (guard->block() != load->block()) {
+    return false;
+  }
+
+  Register* guarded_value = guard->output();
+  bool after_guard = false;
+  for (const Instr& candidate : *guard->block()) {
+    if (&candidate == guard) {
+      after_guard = true;
+      continue;
+    }
+    if (!after_guard) {
+      continue;
+    }
+    if (&candidate == load) {
+      return guarded_value == load->arg(0);
+    }
+    if (candidate.IsUseType() || candidate.IsSnapshot() ||
+        candidate.IsUpdatePrevInstr()) {
+      continue;
+    }
+    if ((candidate.IsAssign() || candidate.IsCheckExc()) &&
+        candidate.GetOperand(0) == guarded_value) {
+      guarded_value = candidate.output();
+      continue;
+    }
+    // Snapshot and UpdatePrevInstr only preserve deoptimization/bytecode
+    // metadata and cannot execute Python or mutate the slot. Calls, branches,
+    // and any other instruction may end the borrow, mutate the slot, or move
+    // the load across an unmodelled effect.
+    return false;
+  }
+  return false;
+}
+
+Register* trySimplifyGuardedUdfDataLoad(Env& env, const VectorCall* instr) {
+#ifdef Py_GIL_DISABLED
+  // A separate thread could end the borrow after the Python guard returns but
+  // before the native load.  Keep the checked Python call on free-threading
+  // builds until the capability protocol has an atomic guard+load operation.
+  (void)env;
+  (void)instr;
+  return nullptr;
+#endif
+  if (instr->frameState() == nullptr ||
+      instr->flags() != CallFlags::None || instr->numArgs() != 1 ||
+      !isExactUdfScalarHelper(
+          instr->func(), reinterpret_cast<PyCFunction>(JITRT_UdfDataLoadF64))) {
+    return nullptr;
+  }
+
+  const VectorCall* guard_call = guardedUdfScalarProducer(instr->arg(0));
+  if (guard_call == nullptr || guard_call->flags() != CallFlags::None ||
+      guard_call->numArgs() != 1 ||
+      !isExactUdfScalarHelper(
+          guard_call->func(),
+          reinterpret_cast<PyCFunction>(JITRT_UdfGuardDataHandle)) ||
+      !isAdjacentUdfGuardChain(guard_call, instr)) {
+    return nullptr;
+  }
+
+  // Preserve the exact global identities on which the native lowering relies.
+  // The primitive load consumes the checked guard result, never guard->arg(0).
+  env.emit<UseType>(guard_call->func(), guard_call->func()->type());
+  env.emit<UseType>(instr->func(), instr->func()->type());
+  Register* value = env.emit<LoadUdfDataF64>(instr->arg(0));
+  return env.emit<PrimitiveBox>(value, TCDouble, *instr->frameState());
 }
 
