+TEST_F(UdfDataIntrinsicTest, HIRMetadataMatchesPrimitiveRead) {
+  auto function = jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = LoadUdfDataF64 v0
+    v2 = PrimitiveBox<CDouble> v1 {
+      FrameState {
+        CurInstrOffset 0
+      }
+    }
+    Return v2
+  }
+}
+)");
+  ASSERT_NE(function, nullptr);
+
+  const jit::hir::Instr* load = nullptr;
+  for (const auto& block : function->cfg.blocks) {
+    for (const auto& instr : block) {
+      if (instr.IsLoadUdfDataF64()) {
+        load = &instr;
+      }
+    }
+  }
+
+  ASSERT_NE(load, nullptr);
+  EXPECT_EQ(jit::hir::outputType(*load), jit::hir::TCDouble);
+  EXPECT_TRUE(load->isReplayable());
+  EXPECT_FALSE(jit::hir::isPassthrough(*load));
+  EXPECT_FALSE(jit::hir::hasArbitraryExecution(*load));
+  EXPECT_EQ(jit::hir::memoryEffects(*load).may_store, jit::hir::AEmpty);
+}
