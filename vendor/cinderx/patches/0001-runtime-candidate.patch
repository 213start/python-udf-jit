+TEST_F(UdfDataIntrinsicTest, RuntimeHelpersEnforceBorrowAndLifetime) {
+  runStockCode(R"(
+import math
+
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_data_load_f64,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+    _udf_set_scalar_slot,
+)
+
+slot = _udf_create_scalar_slot()
+
+for operation in (
+    lambda: _udf_set_scalar_slot(slot, 1.0),
+    lambda: _udf_guard_data_handle(slot),
+    lambda: _udf_data_load_f64(slot),
+):
+    try:
+        operation()
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError("slot access outside an active borrow must fail")
+
+_udf_begin_scalar_slot_borrow(slot)
+for operation in (
+    lambda: _udf_guard_data_handle(slot),
+    lambda: _udf_data_load_f64(slot),
+):
+    try:
+        operation()
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError("a new borrow must be initialized before load")
+for value in (0.0, -0.0, 1.25, float("inf"), float("-inf"), float("nan")):
+    _udf_set_scalar_slot(slot, value)
+    result = _udf_data_load_f64(_udf_guard_data_handle(slot))
+    if math.isnan(value):
+        assert math.isnan(result)
+    else:
+        assert result == value
+        assert math.copysign(1.0, result) == math.copysign(1.0, value)
+_udf_end_scalar_slot_borrow(slot)
+
+_udf_begin_scalar_slot_borrow(slot)
+try:
+    _udf_guard_data_handle(slot)
+except RuntimeError:
+    pass
+else:
+    raise AssertionError("a second borrow must not reuse the previous value")
+_udf_end_scalar_slot_borrow(slot)
+
+try:
+    _udf_set_scalar_slot(slot, 1)
+except RuntimeError:
+    # The borrow check is allowed to win before the exact-float check.
+    pass
+else:
+    raise AssertionError("setting outside an active borrow must fail")
+
+_udf_release_scalar_slot(slot)
+_udf_release_scalar_slot(slot)
+for operation in (
+    lambda: _udf_begin_scalar_slot_borrow(slot),
+    lambda: _udf_guard_data_handle(slot),
+    lambda: _udf_data_load_f64(slot),
+):
+    try:
+        operation()
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError("released slots must stay invalid")
+
+replacement = _udf_create_scalar_slot()
+_udf_begin_scalar_slot_borrow(replacement)
+_udf_set_scalar_slot(replacement, 9.5)
+assert _udf_data_load_f64(_udf_guard_data_handle(replacement)) == 9.5
+_udf_end_scalar_slot_borrow(replacement)
+_udf_release_scalar_slot(replacement)
+
+try:
+    _udf_guard_data_handle(object())
+except TypeError:
+    pass
+else:
+    raise AssertionError("forged handles must fail before data load")
+)");
+}
