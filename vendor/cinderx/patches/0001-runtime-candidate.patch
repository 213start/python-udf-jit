+namespace {
+
+constexpr const char* kUdfScalarSlotCapsuleName =
+    "cinderjit._udf_scalar_slot_f64.v1";
+constexpr uint64_t kUdfScalarSlotMagic = 0x554446534c4f5431ULL;
+constexpr uint64_t kUdfScalarSlotDeadMagic = 0x5544464445414431ULL;
+
+struct UdfScalarSlot {
+  uint64_t magic{kUdfScalarSlotMagic};
+  uint64_t owner_pid{0};
+  uint64_t generation{0};
+  mutable std::mutex mutex;
+  bool borrowed{false};
+  bool released{false};
+  bool initialized{false};
+  double value{0.0};
+};
+
+std::atomic<uint64_t> g_udf_scalar_slot_generation{1};
+std::mutex g_udf_scalar_slots_mutex;
+std::unordered_map<PyObject*, std::unique_ptr<UdfScalarSlot>>
+    g_udf_scalar_slots;
+
+uint64_t udfScalarSlotProcessId() {
+#ifdef WIN32
+  return static_cast<uint64_t>(_getpid());
+#else
+  return static_cast<uint64_t>(getpid());
+#endif
+}
+
+void udfScalarSlotCapsuleDestructor(PyObject* capsule) {
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  if (it == g_udf_scalar_slots.end()) {
+    return;
+  }
+  it->second->magic = kUdfScalarSlotDeadMagic;
+  g_udf_scalar_slots.erase(it);
+}
+
+UdfScalarSlot* checkedUdfScalarSlot(PyObject* capsule) {
+  if (!PyCapsule_CheckExact(capsule)) {
+    PyErr_SetString(
+        PyExc_TypeError, "expected a CinderX float64 scalar-slot capsule");
+    return nullptr;
+  }
+
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  if (it == g_udf_scalar_slots.end()) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "unknown or forged scalar-slot capsule");
+    return nullptr;
+  }
+  UdfScalarSlot* slot = it->second.get();
+  void* pointer = PyCapsule_GetPointer(capsule, kUdfScalarSlotCapsuleName);
+  if (pointer == nullptr) {
+    return nullptr;
+  }
+  auto generation = reinterpret_cast<uintptr_t>(PyCapsule_GetContext(capsule));
+  if (PyErr_Occurred()) {
+    return nullptr;
+  }
+  if (pointer != slot || generation != slot->generation ||
+      slot->magic != kUdfScalarSlotMagic || slot->generation == 0) {
+    PyErr_SetString(PyExc_RuntimeError, "invalid scalar-slot generation");
+    return nullptr;
+  }
+  if (slot->owner_pid != udfScalarSlotProcessId()) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule belongs to another process");
+    return nullptr;
+  }
+  return slot;
+}
+
+bool requireLiveUdfScalarSlot(UdfScalarSlot* slot) {
+  if (slot->released) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule has been released");
+    return false;
+  }
+  return true;
+}
+
+bool requireBorrowedUdfScalarSlot(UdfScalarSlot* slot) {
+  if (!requireLiveUdfScalarSlot(slot)) {
+    return false;
+  }
+  if (!slot->borrowed) {
+    PyErr_SetString(PyExc_RuntimeError, "scalar-slot capsule is not borrowed");
+    return false;
+  }
+  return true;
+}
+
+bool requireInitializedUdfScalarSlot(UdfScalarSlot* slot) {
+  if (!requireBorrowedUdfScalarSlot(slot)) {
+    return false;
+  }
+  if (!slot->initialized) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule has no value for this borrow");
+    return false;
+  }
+  return true;
+}
+
+} // namespace
+
+PyObject* JITRT_UdfCreateScalarSlot(PyObject*, PyObject*) {
+  auto slot = std::make_unique<UdfScalarSlot>();
+  slot->owner_pid = udfScalarSlotProcessId();
+  slot->generation =
+      g_udf_scalar_slot_generation.fetch_add(1, std::memory_order_relaxed);
+  if (slot->generation == 0) {
+    slot->generation =
+        g_udf_scalar_slot_generation.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  PyObject* capsule = PyCapsule_New(
+      slot.get(), kUdfScalarSlotCapsuleName, udfScalarSlotCapsuleDestructor);
+  if (capsule == nullptr) {
+    return nullptr;
+  }
+  if (PyCapsule_SetContext(
+          capsule, reinterpret_cast<void*>(slot->generation)) < 0) {
+    Py_DECREF(capsule);
+    return nullptr;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+    g_udf_scalar_slots.emplace(capsule, std::move(slot));
+  }
+  return capsule;
+}
+
+PyObject* JITRT_UdfSetScalarSlot(PyObject*, PyObject* args) {
+  PyObject* capsule;
+  PyObject* value;
+  if (!PyArg_ParseTuple(args, "OO:_udf_set_scalar_slot", &capsule, &value)) {
+    return nullptr;
+  }
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireBorrowedUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  if (!PyFloat_CheckExact(value)) {
+    PyErr_SetString(
+        PyExc_TypeError, "scalar-slot value must be an exact float");
+    return nullptr;
+  }
+  slot->value = PyFloat_AS_DOUBLE(value);
+  slot->initialized = true;
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfBeginScalarSlotBorrow(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireLiveUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  if (slot->borrowed) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule is already borrowed");
+    return nullptr;
+  }
+  slot->borrowed = true;
+  slot->initialized = false;
+  slot->value = 0.0;
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfEndScalarSlotBorrow(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireLiveUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  if (!slot->borrowed) {
+    PyErr_SetString(PyExc_RuntimeError, "scalar-slot capsule is not borrowed");
+    return nullptr;
+  }
+  slot->borrowed = false;
+  slot->initialized = false;
+  slot->value = 0.0;
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfReleaseScalarSlot(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (slot->released) {
+    Py_RETURN_NONE;
+  }
+  if (slot->borrowed) {
+    PyErr_SetString(
+        PyExc_RuntimeError,
+        "cannot release a scalar slot during an active borrow");
+    return nullptr;
+  }
+  slot->released = true;
+  slot->initialized = false;
+  slot->value = 0.0;
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfGuardDataHandle(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireInitializedUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  Py_INCREF(capsule);
+  return capsule;
+}
+
+PyObject* JITRT_UdfDataLoadF64(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireInitializedUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  return PyFloat_FromDouble(slot->value);
+}
+
+double JITRT_LoadUdfDataF64Unchecked(PyObject* capsule) {
+  // This helper is never exposed to Python.  The HIR rewrite passes the result
+  // of the exact guard call, not the original slot argument.  With that guard
+  // and the active borrow, release and mutation cannot invalidate this read.
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  JIT_CHECK(it != g_udf_scalar_slots.end(), "guarded scalar slot disappeared");
+  const UdfScalarSlot* slot = it->second.get();
+  std::lock_guard<std::mutex> slot_lock{slot->mutex};
+  JIT_CHECK(
+      slot->magic == kUdfScalarSlotMagic && !slot->released && slot->borrowed &&
+          slot->initialized && slot->owner_pid == udfScalarSlotProcessId(),
+      "guarded scalar slot became invalid before data load");
