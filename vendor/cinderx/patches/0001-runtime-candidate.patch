+TEST_F(UdfDataIntrinsicTest, ExactGuardedLoadProducesPrimitiveHIR) {
+  runStockCode(R"(
+import math
+
+import cinderx.jit as jit
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_data_load_f64,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+    _udf_set_scalar_slot,
+)
+
+def calibrated(slot):
+    return _udf_data_load_f64(_udf_guard_data_handle(slot)) * 2.0 - 1.0
+
+def unguarded(slot):
+    return _udf_data_load_f64(slot)
+
+def passthrough(value):
+    return value
+
+def wrong_guard(slot):
+    return _udf_data_load_f64(passthrough(slot))
+
+def fake_load(value):
+    return _udf_data_load_f64(value)
+
+def wrong_load(slot):
+    return fake_load(_udf_guard_data_handle(slot))
+
+def end_between_guard_and_load(slot):
+    guarded = _udf_guard_data_handle(slot)
+    _udf_end_scalar_slot_borrow(slot)
+    return _udf_data_load_f64(guarded)
+
+assert jit.force_compile(calibrated)
+assert jit.force_compile(unguarded)
+assert jit.force_compile(wrong_guard)
+assert jit.force_compile(wrong_load)
+assert jit.force_compile(end_between_guard_and_load)
+assert jit.is_jit_compiled(calibrated)
+
+counts = jit.get_function_hir_opcode_counts(calibrated)
+assert counts.get("LoadUdfDataF64", 0) == 1, counts
+assert jit.get_function_hir_opcode_counts(unguarded).get("LoadUdfDataF64", 0) == 0
+assert jit.get_function_hir_opcode_counts(wrong_guard).get("LoadUdfDataF64", 0) == 0
+assert jit.get_function_hir_opcode_counts(wrong_load).get("LoadUdfDataF64", 0) == 0
+assert jit.get_function_hir_opcode_counts(end_between_guard_and_load).get("LoadUdfDataF64", 0) == 0
+
+interposed_slot = _udf_create_scalar_slot()
+_udf_begin_scalar_slot_borrow(interposed_slot)
+_udf_set_scalar_slot(interposed_slot, 4.0)
+try:
+    end_between_guard_and_load(interposed_slot)
+except RuntimeError:
+    pass
+else:
+    raise AssertionError("load after end_borrow must retain interpreter failure")
+_udf_release_scalar_slot(interposed_slot)
+
+slot = _udf_create_scalar_slot()
+_udf_begin_scalar_slot_borrow(slot)
+for value in (0.0, -0.0, 1.25, 1.7976931348623157e308, float("inf"), float("-inf"), float("nan")):
+    _udf_set_scalar_slot(slot, value)
+    expected = value * 2.0 - 1.0
+    result = calibrated(slot)
+    if math.isnan(expected):
+        assert math.isnan(result)
+    else:
+        assert result == expected
+        if expected == 0.0:
+            assert math.copysign(1.0, result) == math.copysign(1.0, expected)
+_udf_end_scalar_slot_borrow(slot)
+_udf_release_scalar_slot(slot)
+for invalid in (slot, object()):
+    try:
+        calibrated(invalid)
+    except (RuntimeError, TypeError):
+        pass
+    else:
+        raise AssertionError("descriptor guard must fail before native load")
+)");
+}
