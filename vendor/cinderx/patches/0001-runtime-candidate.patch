@@ -0,0 +1,193 @@
+"""Tests for the guarded scalar-slot float64 CinderX intrinsic."""
+
+import math
+import os
+import unittest
+
+import cinderx.jit
+
+try:
+    from cinderjit import (
+        _udf_begin_scalar_slot_borrow,
+        _udf_create_scalar_slot,
+        _udf_data_load_f64,
+        _udf_end_scalar_slot_borrow,
+        _udf_guard_data_handle,
+        _udf_release_scalar_slot,
+        _udf_set_scalar_slot,
+    )
+except ImportError:
+    _udf_create_scalar_slot = None
+
+
+@unittest.skipUnless(
+    cinderx.jit.is_enabled() and _udf_create_scalar_slot is not None,
+    "requires CinderX JIT scalar-slot helpers",
+)
+class UdfDataIntrinsicTests(unittest.TestCase):
+    def setUp(self):
+        self.slot = _udf_create_scalar_slot()
+
+    def tearDown(self):
+        try:
+            _udf_end_scalar_slot_borrow(self.slot)
+        except RuntimeError:
+            pass
+        _udf_release_scalar_slot(self.slot)
+
+    def test_interpreter_lifecycle_and_exact_float(self):
+        with self.assertRaises(RuntimeError):
+            _udf_guard_data_handle(self.slot)
+
+        _udf_begin_scalar_slot_borrow(self.slot)
+        with self.assertRaises(RuntimeError):
+            _udf_guard_data_handle(self.slot)
+        for value in (0.0, -0.0, 1.25, float("inf"), float("-inf"), float("nan")):
+            _udf_set_scalar_slot(self.slot, value)
+            result = _udf_data_load_f64(_udf_guard_data_handle(self.slot))
+            if math.isnan(value):
+                self.assertTrue(math.isnan(result))
+            else:
+                self.assertEqual(result, value)
+                self.assertEqual(math.copysign(1.0, result), math.copysign(1.0, value))
+
+        with self.assertRaises(TypeError):
+            _udf_set_scalar_slot(self.slot, 1)
+
+        _udf_end_scalar_slot_borrow(self.slot)
+        _udf_begin_scalar_slot_borrow(self.slot)
+        with self.assertRaises(RuntimeError):
+            _udf_data_load_f64(self.slot)
+
+    def test_release_is_idempotent_and_prevents_aba(self):
+        _udf_begin_scalar_slot_borrow(self.slot)
+        with self.assertRaises(RuntimeError):
+            _udf_release_scalar_slot(self.slot)
+        _udf_end_scalar_slot_borrow(self.slot)
+
+        _udf_release_scalar_slot(self.slot)
+        _udf_release_scalar_slot(self.slot)
+        with self.assertRaises(RuntimeError):
+            _udf_begin_scalar_slot_borrow(self.slot)
+
+        replacement = _udf_create_scalar_slot()
+        try:
+            _udf_begin_scalar_slot_borrow(replacement)
+            _udf_set_scalar_slot(replacement, 7.0)
+            self.assertEqual(
+                _udf_data_load_f64(_udf_guard_data_handle(replacement)), 7.0
+            )
+            with self.assertRaises(RuntimeError):
+                _udf_guard_data_handle(self.slot)
+            _udf_end_scalar_slot_borrow(replacement)
+        finally:
+            _udf_release_scalar_slot(replacement)
+
+    @unittest.skipUnless(hasattr(os, "fork"), "requires fork")
+    def test_cross_process_capsule_is_rejected(self):
+        _udf_begin_scalar_slot_borrow(self.slot)
+        pid = os.fork()
+        if pid == 0:
+            try:
+                _udf_guard_data_handle(self.slot)
+            except RuntimeError:
+                os._exit(0)
+            os._exit(1)
+        _, status = os.waitpid(pid, 0)
+        self.assertEqual(os.waitstatus_to_exitcode(status), 0)
+
+    def test_exact_guarded_call_is_compiled_and_wrong_guard_is_not(self):
+        def calibrated(slot):
+            return _udf_data_load_f64(_udf_guard_data_handle(slot)) * 2.0 - 1.0
+
+        def unguarded(slot):
+            return _udf_data_load_f64(slot)
+
+        def passthrough(value):
+            return value
+
+        def wrong_guard(slot):
+            return _udf_data_load_f64(passthrough(slot))
+
+        def fake_load(value):
+            return _udf_data_load_f64(value)
+
+        def wrong_load(slot):
+            return fake_load(_udf_guard_data_handle(slot))
+
+        self.assertTrue(cinderx.jit.force_compile(calibrated))
+        self.assertTrue(cinderx.jit.force_compile(unguarded))
+        self.assertTrue(cinderx.jit.force_compile(wrong_guard))
+        self.assertTrue(cinderx.jit.force_compile(wrong_load))
+        self.assertTrue(cinderx.jit.is_jit_compiled(calibrated))
+        self.assertEqual(
+            cinderx.jit.get_function_hir_opcode_counts(calibrated).get(
+                "LoadUdfDataF64", 0
+            ),
+            1,
+        )
+        self.assertEqual(
+            cinderx.jit.get_function_hir_opcode_counts(unguarded).get(
+                "LoadUdfDataF64", 0
+            ),
+            0,
+        )
+        self.assertEqual(
+            cinderx.jit.get_function_hir_opcode_counts(wrong_guard).get(
+                "LoadUdfDataF64", 0
+            ),
+            0,
+        )
+        self.assertEqual(
+            cinderx.jit.get_function_hir_opcode_counts(wrong_load).get(
+                "LoadUdfDataF64", 0
+            ),
+            0,
+        )
+
+        _udf_begin_scalar_slot_borrow(self.slot)
+        for value in (
+            0.0,
+            -0.0,
+            1.25,
+            1.7976931348623157e308,
+            float("inf"),
+            float("-inf"),
+            float("nan"),
+        ):
+            _udf_set_scalar_slot(self.slot, value)
+            expected = value * 2.0 - 1.0
+            result = calibrated(self.slot)
+            if math.isnan(expected):
+                self.assertTrue(math.isnan(result))
+            else:
+                self.assertEqual(result, expected)
+
+        _udf_end_scalar_slot_borrow(self.slot)
+        _udf_release_scalar_slot(self.slot)
+        with self.assertRaises(RuntimeError):
+            calibrated(self.slot)
+        with self.assertRaises(TypeError):
+            calibrated(object())
+
+    def test_state_change_between_guard_and_load_disables_intrinsic(self):
+        def end_between_guard_and_load(slot):
+            guarded = _udf_guard_data_handle(slot)
+            _udf_end_scalar_slot_borrow(slot)
+            return _udf_data_load_f64(guarded)
+
+        self.assertTrue(cinderx.jit.force_compile(end_between_guard_and_load))
+        self.assertEqual(
+            cinderx.jit.get_function_hir_opcode_counts(
+                end_between_guard_and_load
+            ).get("LoadUdfDataF64", 0),
+            0,
+        )
+        _udf_begin_scalar_slot_borrow(self.slot)
+        _udf_set_scalar_slot(self.slot, 3.0)
+        with self.assertRaises(RuntimeError):
+            end_between_guard_and_load(self.slot)
+
+
+if __name__ == "__main__":
+    unittest.main()
