+std::string permissionsFor(const void* address) {
+#ifndef WIN32
+  std::ifstream maps{"/proc/self/maps"};
+  std::string range;
+  std::string permissions;
+  auto target = reinterpret_cast<uintptr_t>(address);
+  while (maps >> range >> permissions) {
+    auto separator = range.find('-');
+    if (separator == std::string::npos) {
+      continue;
+    }
+    uintptr_t start = std::stoull(range.substr(0, separator), nullptr, 16);
+    uintptr_t end = std::stoull(range.substr(separator + 1), nullptr, 16);
+    if (start <= target && target < end) {
+      return permissions;
+    }
+    std::string remainder;
+    std::getline(maps, remainder);
+  }
+#else
+  (void)address;
+#endif
+  return {};
+}
