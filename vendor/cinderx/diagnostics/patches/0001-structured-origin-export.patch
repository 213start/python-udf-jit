--- /dev/null
+++ b/cinderx/Jit/udf_jit_diagnostics.h
@@ -0,0 +1,49 @@
+// Copyright (c) Meta Platforms, Inc. and affiliates.
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace jit {
+
+// Value-free structural records retained only when
+// PYTHONJITUDFDIAGNOSTICS is enabled before JIT initialization.
+struct UdfJitHirNode {
+  uint64_t id;
+  std::string opcode;
+  std::optional<int> bytecode_offset;
+  std::string synthetic_kind;
+};
+
+struct UdfJitLirNode {
+  int id;
+  std::string opcode;
+  std::optional<uint64_t> hir_id;
+  std::string synthetic_kind;
+};
+
+struct UdfJitMachineRange {
+  uint64_t id;
+  uintptr_t start;
+  uintptr_t end;
+  std::string section;
+  std::string symbol;
+  std::optional<int> lir_id;
+  std::optional<uint64_t> hir_id;
+  std::string synthetic_kind;
+};
+
+struct UdfJitCompilationDiagnostics {
+  std::vector<UdfJitHirNode> hir_nodes;
+  std::vector<UdfJitLirNode> lir_nodes;
+  std::vector<UdfJitMachineRange> machine_ranges;
+};
+
+using UdfJitCompilationDiagnosticsPtr =
+    std::unique_ptr<UdfJitCompilationDiagnostics>;
+
+} // namespace jit
