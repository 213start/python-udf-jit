+PyObject* get_udfjit_compilation_diagnostics(
+    PyObject* /* self */,
+    PyObject* args) {
+  PyObject* raw_func;
+  PyObject* raw_compile_instance_id;
+  if (!PyArg_ParseTuple(
+          args,
+          "OO:get_udfjit_compilation_diagnostics",
+          &raw_func,
+          &raw_compile_instance_id)) {
+    return nullptr;
+  }
+  BorrowedRef<PyFunctionObject> func =
+      get_func_arg("get_udfjit_compilation_diagnostics", raw_func);
+  if (func == nullptr) {
+    return nullptr;
+  }
+  if (!PyUnicode_Check(raw_compile_instance_id)) {
+    PyErr_SetString(PyExc_TypeError, "compile_instance_id must be a string");
+    return nullptr;
+  }
+  if (!getConfig().udf_jit_diagnostics) {
+    PyErr_SetString(
+        PyExc_RuntimeError,
+        "UDF JIT diagnostics are disabled; set "
+        "PYTHONJITUDFDIAGNOSTICS before JIT initialization");
+    return nullptr;
+  }
+  Ref<> generated_code_hash = Ref<>::steal(
+      PyObject_GetAttrString(raw_func, "__udfjit_generated_code_hash__"));
+  if (generated_code_hash == nullptr) {
+    return nullptr;
+  }
+  if (!PyUnicode_Check(generated_code_hash)) {
+    PyErr_SetString(
+        PyExc_TypeError, "__udfjit_generated_code_hash__ must be a string");
+    return nullptr;
+  }
+
+  Ref<> pass_timings = Ref<>::steal(PyList_New(0));
+  Ref<> result = Ref<>::steal(PyDict_New());
+  if (pass_timings == nullptr || result == nullptr) {
+    return nullptr;
+  }
+  CompiledFunction* compiled_func =
+      jitCtx() == nullptr ? nullptr : jitCtx()->lookupFunc(func);
+  const UdfJitCompilationDiagnostics* diagnostics =
+      compiled_func == nullptr ? nullptr : compiled_func->udfJitDiagnostics();
+  const bool available = compiled_func != nullptr && diagnostics != nullptr;
+
+  Ref<> hir_nodes = available ? buildUdfJitHirNodes(*diagnostics)
+                              : Ref<>::steal(PyList_New(0));
+  Ref<> lir_nodes = available ? buildUdfJitLirNodes(*diagnostics)
+                              : Ref<>::steal(PyList_New(0));
+  Ref<> machine_ranges = available ? buildUdfJitMachineRanges(*diagnostics)
+                                   : Ref<>::steal(PyList_New(0));
+  Ref<> deopt_metadata = Ref<>::steal(PyList_New(0));
+  if (hir_nodes == nullptr || lir_nodes == nullptr ||
+      machine_ranges == nullptr || deopt_metadata == nullptr) {
+    return nullptr;
+  }
+  if (available) {
+    Ref<> timing = Ref<>::steal(PyDict_New());
+    if (timing == nullptr ||
+        !setDiagnosticField(timing, "name", diagnosticText("overall")) ||
+        !setDiagnosticField(
+            timing, "ordinal", Ref<>::steal(PyLong_FromLong(0))) ||
+        !setDiagnosticField(
+            timing,
+            "duration_ns",
+            Ref<>::steal(
+                PyLong_FromLongLong(compiled_func->compileTime().count()))) ||
+        !appendDiagnostic(pass_timings, std::move(timing))) {
+      return nullptr;
+    }
+  }
+
+  if (!setDiagnosticField(
+          result, "schema_version", Ref<>::steal(PyLong_FromLong(1))) ||
+      !setDiagnosticField(
+          result,
+          "status",
+          diagnosticText(available ? "available" : "not_compiled")) ||
+      PyDict_SetItemString(
+          result, "compile_instance_id", raw_compile_instance_id) < 0 ||
+      PyDict_SetItemString(result, "generated_code_hash", generated_code_hash) <
+          0 ||
+      !setDiagnosticField(
+          result,
+          "jit_compiled",
+          Ref<>::create(available ? Py_True : Py_False)) ||
+      !setDiagnosticField(
+          result, "unavailable_reason", Ref<>::create(Py_None)) ||
+      !setDiagnosticField(
+          result,
+          "jit_gate_reason",
+          available ? Ref<>::create(Py_None)
+                    : diagnosticText("not_jit_compiled")) ||
+      !setDiagnosticField(
+          result,
+          "code_start",
+          available ? Ref<>::steal(PyLong_FromUnsignedLongLong(
+                          reinterpret_cast<uintptr_t>(
+                              compiled_func->codeBuffer().data())))
+                    : Ref<>::create(Py_None)) ||
+      !setDiagnosticField(
+          result,
+          "code_size",
+          Ref<>::steal(
+              PyLong_FromSize_t(available ? compiled_func->codeSize() : 0))) ||
+      !setDiagnosticField(
+          result,
+          "stack_size",
+          Ref<>::steal(
+              PyLong_FromLong(available ? compiled_func->stackSize() : 0))) ||
+      !setDiagnosticField(
+          result,
+          "spill_stack_size",
+          Ref<>::steal(PyLong_FromLong(
+              available ? compiled_func->spillStackSize() : 0))) ||
+      !setDiagnosticField(result, "pass_timings", std::move(pass_timings)) ||
+      !setDiagnosticField(result, "hir_nodes", std::move(hir_nodes)) ||
+      !setDiagnosticField(result, "lir_nodes", std::move(lir_nodes)) ||
+      !setDiagnosticField(
+          result, "machine_ranges", std::move(machine_ranges)) ||
+      !setDiagnosticField(
+          result, "deopt_metadata", std::move(deopt_metadata))) {
+    return nullptr;
+  }
+  return result.release();
+}
