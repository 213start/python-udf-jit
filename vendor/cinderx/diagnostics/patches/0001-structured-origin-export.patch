+bool setDiagnosticField(
+    BorrowedRef<> dictionary,
+    const char* name,
+    Ref<> value) {
+  return value != nullptr && PyDict_SetItemString(dictionary, name, value) == 0;
+}
+
+Ref<> diagnosticText(std::string_view value) {
+  return Ref<>::steal(PyUnicode_FromStringAndSize(value.data(), value.size()));
+}
+
+Ref<> diagnosticOptionalText(const std::string& value) {
+  return value.empty() ? Ref<>::create(Py_None) : diagnosticText(value);
+}
+
+Ref<> diagnosticOptionalInteger(const std::optional<int>& value) {
+  return value.has_value() ? Ref<>::steal(PyLong_FromLong(*value))
+                           : Ref<>::create(Py_None);
+}
+
+template <typename Value>
+bool appendDiagnostic(BorrowedRef<> list, Value&& value) {
+  Ref<> item = std::forward<Value>(value);
+  return item != nullptr && PyList_Append(list, item) == 0;
+}
+
+Ref<> buildUdfJitHirNodes(const UdfJitCompilationDiagnostics& diagnostics) {
+  Ref<> result = Ref<>::steal(PyList_New(0));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  for (const UdfJitHirNode& node : diagnostics.hir_nodes) {
+    Ref<> record = Ref<>::steal(PyDict_New());
+    std::string id = std::to_string(node.id);
+    if (record == nullptr ||
+        !setDiagnosticField(record, "hir_id", diagnosticText(id)) ||
+        !setDiagnosticField(record, "opcode", diagnosticText(node.opcode)) ||
+        !setDiagnosticField(
+            record,
+            "bytecode_offset",
+            diagnosticOptionalInteger(node.bytecode_offset)) ||
+        !setDiagnosticField(
+            record,
+            "synthetic_kind",
+            diagnosticOptionalText(node.synthetic_kind)) ||
+        !appendDiagnostic(result, std::move(record))) {
+      return nullptr;
+    }
+  }
+  return result;
+}
+
+Ref<> buildUdfJitLirNodes(const UdfJitCompilationDiagnostics& diagnostics) {
+  Ref<> result = Ref<>::steal(PyList_New(0));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  for (const UdfJitLirNode& node : diagnostics.lir_nodes) {
+    Ref<> origins = Ref<>::steal(PyList_New(0));
+    if (origins == nullptr) {
+      return nullptr;
+    }
+    if (node.hir_id.has_value()) {
+      std::string id = std::to_string(*node.hir_id);
+      if (!appendDiagnostic(origins, diagnosticText(id))) {
+        return nullptr;
+      }
+    }
+    Ref<> record = Ref<>::steal(PyDict_New());
+    std::string id = std::to_string(node.id);
+    if (record == nullptr ||
+        !setDiagnosticField(record, "lir_id", diagnosticText(id)) ||
+        !setDiagnosticField(record, "opcode", diagnosticText(node.opcode)) ||
+        !setDiagnosticField(record, "hir_ids", std::move(origins)) ||
+        !setDiagnosticField(
+            record,
+            "synthetic_kind",
+            diagnosticOptionalText(node.synthetic_kind)) ||
+        !appendDiagnostic(result, std::move(record))) {
+      return nullptr;
+    }
+  }
+  return result;
+}
+
+Ref<> buildUdfJitMachineRanges(
+    const UdfJitCompilationDiagnostics& diagnostics) {
+  Ref<> result = Ref<>::steal(PyList_New(0));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  for (const UdfJitMachineRange& range : diagnostics.machine_ranges) {
+    Ref<> lir_origins = Ref<>::steal(PyList_New(0));
+    Ref<> hir_origins = Ref<>::steal(PyList_New(0));
+    if (lir_origins == nullptr || hir_origins == nullptr) {
+      return nullptr;
+    }
+    if (range.lir_id.has_value()) {
+      if (!appendDiagnostic(
+              lir_origins, diagnosticText(std::to_string(*range.lir_id)))) {
+        return nullptr;
+      }
+    }
+    if (range.hir_id.has_value()) {
+      if (!appendDiagnostic(
+              hir_origins, diagnosticText(std::to_string(*range.hir_id)))) {
+        return nullptr;
+      }
+    }
+    Ref<> record = Ref<>::steal(PyDict_New());
+    if (record == nullptr ||
+        !setDiagnosticField(
+            record, "range_id", diagnosticText(std::to_string(range.id))) ||
+        !setDiagnosticField(
+            record,
+            "start",
+            Ref<>::steal(PyLong_FromUnsignedLongLong(range.start))) ||
+        !setDiagnosticField(
+            record,
+            "end",
+            Ref<>::steal(PyLong_FromUnsignedLongLong(range.end))) ||
+        !setDiagnosticField(record, "section", diagnosticText(range.section)) ||
+        !setDiagnosticField(record, "symbol", diagnosticText(range.symbol)) ||
+        !setDiagnosticField(record, "lir_ids", std::move(lir_origins)) ||
+        !setDiagnosticField(record, "hir_ids", std::move(hir_origins)) ||
+        !setDiagnosticField(
+            record,
+            "synthetic_kind",
+            diagnosticOptionalText(range.synthetic_kind)) ||
+        !appendDiagnostic(result, std::move(record))) {
+      return nullptr;
+    }
+  }
+  return result;
+}
