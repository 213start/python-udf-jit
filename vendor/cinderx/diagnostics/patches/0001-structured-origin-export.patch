+std::vector<ResolvedAnnotation> Annotations::resolve(
+    void* entry,
+    const asmjit::CodeHolder& code) const {
+  JIT_CHECK(code.hasBaseAddress(), "code not generated!");
+  std::vector<ResolvedAnnotation> result;
+  auto base = reinterpret_cast<uintptr_t>(entry);
+  for (const Annotation& annotation : annotations_) {
+    uintptr_t start = base + code.labelOffsetFromBase(annotation.begin);
+    uintptr_t end = base + code.labelOffsetFromBase(annotation.end);
+    if (start >= end) {
+      continue;
+    }
+    forEachSection([&](CodeSection section) {
+      auto text = code.sectionByName(codeSectionName(section));
+      if (text == nullptr) {
+        return;
+      }
+      uintptr_t section_start = base + text->offset();
+      uintptr_t section_end = section_start + text->realSize();
+      if (start >= section_start && end <= section_end) {
+        result.push_back(ResolvedAnnotation{
+            start,
+            end,
+            section,
+            annotation.instr,
+            annotation.instr == nullptr,
+        });
+      }
+    });
+  }
+  std::sort(
+      result.begin(),
+      result.end(),
+      [](const ResolvedAnnotation& left, const ResolvedAnnotation& right) {
+        return std::tie(left.start, left.end) <
+            std::tie(right.start, right.end);
+      });
+  return result;
+}
