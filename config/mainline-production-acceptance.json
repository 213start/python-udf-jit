{
  "$schema": "mainline-release-prerequisites.schema.json",
  "schema_version": 2,
  "contract_schema": "urn:python-udf-jit:mainline-release-prerequisites:v1",
  "profile": "mainline-production",
  "support_matrix": "mainline-support-matrix.json",
  "support_matrix_sha256": "045cdfc83bb868edd6086e32d6bc293b5d6a75e8bc64255c70e11a923b548628",
  "unit_completion_values": ["incomplete", "complete"],
  "gate_outcome_values": ["pass", "fail", "stop", "inconclusive"],
  "performance_policy": {
    "target_speedup": 1.15,
    "default_mode": "directional",
    "target_applies_to": "formal_only",
    "blocks_functional_completion": false,
    "below_target_disposition": "record_non_blocking_result"
  },
  "performance_baseline": {
    "mode": "directional",
    "workload": "tpch_sf10_lineitem_scalar_q6",
    "approximate_rows": 60000000,
    "baseline": {
      "mode": "off",
      "execution": "original_daft_scalar_udf"
    },
    "candidate": {
      "mode": "auto",
      "enabled_rfcs": [
        "RFC-001",
        "RFC-002",
        "RFC-003",
        "RFC-004",
        "RFC-005",
        "RFC-006",
        "RFC-007",
        "RFC-008"
      ],
      "disabled_rfcs": ["RFC-009", "RFC-010", "RFC-011", "RFC-012"]
    },
    "environment_constraint": "same_environment",
    "off_runs": 1,
    "auto_runs": 1,
    "conclusion_scope": "directional_only",
    "correctness": "ordered_result_and_aggregate_hash_equal",
    "blocks_functional_completion": false
  },
  "formal_performance_qualification": {
    "mode": "formal",
    "cli_flag": "--formal",
    "warmup_runs": 1,
    "alternating_measured_runs": 5,
    "statistic": "median",
    "stability_metrics": ["mad", "drift"],
    "target_speedup": 1.15,
    "fallback_minimum_ratio": 0.98,
    "blocks_functional_completion": false
  },
  "disabled_rfcs": ["RFC-009", "RFC-010", "RFC-011", "RFC-012"],
  "test_suites": {
    "unit": {
