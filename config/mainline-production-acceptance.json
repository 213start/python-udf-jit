      "test_multitype_semantic_module_round_trips_and_matches_cpython",
      "test_legacy_f64_capture_enters_the_semantic_pipeline",
      "test_non_jit_types_never_claim_a_cinderx_region",
      "test_all_required_analyses_are_value_free_and_hash_bound",
      "test_cached_analysis_is_reused_and_unpreserved_proof_recomputes",
      "test_incorrect_preserved_analysis_is_rejected_as_stale",
      "test_node_iteration_and_time_budgets_return_no_partial_regions",
      "test_pure_f64_chain_forms_one_verified_cinderx_candidate",
      "test_may_raise_operations_preserve_exception_order_edges",
      "test_python_region_is_an_exact_once_continuation_barrier",
      "test_control_flow_and_effect_boundaries_never_merge",
      "test_multiple_effects_receive_explicit_order_edges",
      "test_semantic_verifier_rejects_exception_cfg_and_python_region_drift",
      "test_rfc003_unit_contract"
      ],
      "expected_test_count": 225,
      "allow_skips": false
    },
