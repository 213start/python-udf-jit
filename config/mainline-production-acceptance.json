      "tier": "unit",
      "arguments": ["discover", "-s", "tests/unit", "-v"],
      "required_tests": [
        "test_scalar_and_mainline_profiles_load_independently",
        "test_resolution_priority_is_disable_plugin_mode_compatibility_policy",
        "test_poor_performance_does_not_fail_functional_completion",
        "test_cross_code_object_state_preserves_null_alias_and_exception",
        "test_missing_gate_evidence_is_absent_not_inconclusive",
        "test_named_profiles_and_explicit_json_paths_resolve",
        "test_receipt_rejects_exact_count_drift_from_profile",
        "test_validator_rejects_environment_phase_and_performance_tampering",
        "test_formal_self_check_accepts_milestone_scope_without_claiming_release",
        "test_capture_is_deferred_until_operation_schema_is_available",
        "test_where_select_and_with_columns_finalize_each_candidate_once",
        "test_deserialization_rejects_missing_or_unsupported_versions",
        "test_installs_packaged_pth_at_explicit_purelib_root_idempotently",
        "test_rejects_an_unsupported_runtime_format_before_decoding",
        "test_normalizes_required_opcode_families_without_source_values",
        "test_decodes_exception_and_location_tables_with_complete_coverage",
        "test_canonical_encoding_round_trips_and_is_cross_process_stable",
        "test_rejects_corrupt_location_and_exception_tables",
        "test_local_join_builds_control_edges_and_local_phi",
        "test_short_circuit_builds_stack_phi",
        "test_verifier_rejects_each_structural_layer",
        "test_straight_line_numeric_function_needs_no_python_region",
        "test_opaque_call_forms_side_effect_region_with_exact_resume",
        "test_controlled_calls_and_readonly_aggregates_stay_python_regions",
        "test_exception_regions_retain_handler_state",
        "test_small_function_is_modeled_but_remains_a_python_region",
        "test_analysis_never_executes_the_user_function",
        "test_program_encoding_round_trips_without_source_or_names",
        "test_two_opaque_calls_have_stable_nonoverlapping_regions",
        "test_verifier_rejects_resume_live_and_coverage_corruption",
        "test_static_capture_does_not_change_cpython_results",
        "test_code_and_dependencies_are_separate",
        "test_global_and_default_changes_only_dependency_fingerprint",
        "test_opaque_dependency_rejects_without_repr_or_address",
        "test_identity_is_cross_process_stable",
      "test_capture_cache_is_job_scoped_ttl_and_lru_bounded",
