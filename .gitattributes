# 仓库中的文本文件统一使用 LF，避免不同操作系统产生整库行尾差异。
* text=auto eol=lf

# 明确常见源码、配置、文档和补丁都是文本文件。
*.py text eol=lf
*.pyi text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.sh text eol=lf
*.pth text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.patch text eol=lf
*.diff text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
CMakeLists.txt text eol=lf

# 二进制制品不参与文本规范化。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.whl binary
*.so binary
*.dylib binary
*.dll binary
*.wasm binary
